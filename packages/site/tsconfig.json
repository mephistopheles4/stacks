{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Kept in step with ../../tsconfig.base.json on purpose, and now
    // load-bearing: `astro check` reads this file, and `astro check` is G47
    // (astro-types), so relaxing an option here weakens a gate from a file no
    // clause of that gate reads.
    //
    // `astro check` owns everything under packages/site, .ts files included.
    // The root config reaches those same .ts files — its include list carries
    // `packages/site/src/**/*.ts` — but excludes `**/.astro`, so it typechecks
    // them WITHOUT astro's generated types while this config typechecks them
    // with. That difference is the whole of the TS2717 that #250 fixed in
    // boot.ts. (This comment previously said the root config "deliberately
    // excludes" the site's .ts files. It does not, and never has.)
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
