---
// The 3D island. Vanilla Three.js in a plain <script> — no React on the page.
// Markup and styles only: all logic lives in ../shelf/*.ts, which is
// typechecked. See "Site code layout" in CLAUDE.md.
---

<div class="shelf">
  <!--
    `tabindex="-1"` makes the canvas *programmatically* focusable without ever
    becoming a tab stop. It is where focus lands when the control that held it
    (the X, the Open button, a link on a page) goes away with the book, or when
    the Open button hides as the book opens.
  -->
  <canvas id="shelf-canvas" tabindex="-1"></canvas>

  <!--
    The announcer: permanently present and visually hidden. «Title» by «Author»
    when a book is picked up, the new book's on a second pickup, and empty after
    put-back (spec §3.4). The held book's pages are ordinary DOM in reading
    order, placed in the scene by ../shelf/pickup.ts; this is what tells a
    screen reader a book is in hand at all, since the canvas has no accessible
    children.
  -->
  <p id="pickup-status" class="visually-hidden" role="status"></p>
</div>

<script>
  import { start } from '../shelf/start.ts';

  start();
</script>

<style>
  .shelf {
    position: absolute;
    inset: 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  /*
   * The held book's pages, placed by `CSS3DRenderer` in ../shelf/pickup.ts.
   * `:global` because that module creates them, and Astro only stamps its
   * scoping attribute on elements that were in this template. Sizes, opacity
   * and visibility are set through CSSOM there, which `style-src` does not
   * govern; everything here is the static look.
   */
  .shelf :global(.held-layer) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Above the canvas, below the two debug surfaces (10 and 11). */
    z-index: 5;
  }

  .shelf :global(.held-page) {
    box-sizing: border-box;
    padding: 44px 40px;
    overflow: hidden;
    color: #2b2520;
    font: 17px/1.55 Georgia, 'Iowan Old Style', 'Palatino Linotype', serif;
    overflow-wrap: anywhere;
  }

  /* Focused by script when the book is opened from its button: no ring on a 3D page. */
  .shelf :global(.held-page-right:focus) {
    outline: none;
  }

  .shelf :global(.held-page-left) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .shelf :global(.held-title) {
    margin: 0;
    font: 600 26px/1.2 Georgia, serif;
  }

  .shelf :global(.held-page-right .held-title) {
    font-size: 22px;
  }

  .shelf :global(.held-author) {
    margin: 14px 0 0;
    font-style: italic;
    color: #5d5347;
  }

  .shelf :global(.held-page-right .held-author) {
    margin-bottom: 22px;
  }

  .shelf :global(.held-label) {
    margin: 0 0 22px;
    font: 600 12px/1 ui-sans-serif, system-ui, sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a7d6c;
  }

  .shelf :global(.held-thoughts p:not(.held-label)) {
    margin: 0 0 14px;
    text-indent: 1.4em;
    white-space: pre-line;
  }

  .shelf :global(.held-thoughts hr) {
    margin: 20px 0;
    border: 0;
    border-top: 1px solid rgba(43, 37, 32, 0.2);
  }

  .shelf :global(.held-page .reading) {
    margin: 0 0 10px;
    font-style: italic;
  }

  .shelf :global(.held-page .tags),
  .shelf :global(.held-page .object),
  .shelf :global(.held-page .subjects) {
    margin: 0 0 8px;
    font: 14px/1.5 ui-sans-serif, system-ui, sans-serif;
    color: #5d5347;
  }

  .shelf :global(.held-page .card-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    margin-top: 10px;
    font: 14px/1.5 ui-sans-serif, system-ui, sans-serif;
  }

  .shelf :global(.held-page .card-link) {
    display: inline-flex;
    align-items: center;
    /* WCAG 2.5.5: the row is the page's main tappable content. */
    min-height: 2.75rem;
    color: #5d5347;
    text-decoration: none;
  }

  .shelf :global(.held-page .card-link:hover),
  .shelf :global(.held-page .card-link:focus-visible) {
    color: #2b2520;
  }

  .shelf :global(.held-page .card-mark) {
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }

  .shelf :global(.held-page .held-turn-over),
  .shelf :global(.held-page .held-close) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin: 12px 12px 0 0;
    padding: 0 14px;
    border: 1px solid rgba(43, 37, 32, 0.3);
    border-radius: 6px;
    background: transparent;
    color: #2b2520;
    font: 14px/1 ui-sans-serif, system-ui, sans-serif;
    cursor: pointer;
  }

  /*
    The foot's "Close the book" carries a book's outline beside the words. The
    control by the title is the arrow alone (#553, at the owner's word), a
    square the size of a fingertip, borderless until it is pointed at: at the
    top left of the left page, which never scrolls; on a phone, at the top of
    the right page, held in view by `sticky` while the Thoughts scroll under it,
    there on a ground of the page's own paper so no line shows through. Its own
    row, so it never sits on the title.
  */
  .shelf :global(.held-page .held-turn-over) {
    gap: 8px;
  }

  .shelf :global(.held-page .held-close) {
    justify-content: center;
    width: 2.75rem;
    margin: 0;
    padding: 0;
    border-color: transparent;
    border-radius: 50%;
    color: #5d5347;
  }

  .shelf :global(.held-page .held-close:hover) {
    border-color: rgba(43, 37, 32, 0.3);
    color: #2b2520;
  }

  .shelf :global(.held-page .held-close svg) {
    width: 22px;
    height: 22px;
  }

  .shelf :global(.held-page-left .held-close) {
    position: absolute;
    top: 20px;
    left: 20px;
  }

  .shelf :global(.held-page-right .held-close) {
    position: sticky;
    top: 0;
    z-index: 1;
    background: #ece2cf;
    margin: -28px 0 18px -20px;
  }

  .shelf :global(.held-page button:focus-visible),
  .shelf :global(.held-page a:focus-visible) {
    outline: 2px solid #2b2520;
    outline-offset: 2px;
  }

  /*
   * Shown when there is no shelf to show, with the canvas hidden behind it —
   * see showNotice in ../shelf/shelf-notice.ts. `:global` because that module
   * creates it, and Astro only stamps its scoping attribute on elements that
   * were in this template.
   */
  .shelf :global(.shelf-notice) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(24rem, calc(100vw - 3rem));
    margin: 0;
    transform: translate(-50%, -50%);
    text-align: center;
    text-wrap: balance;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #a89684;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

</style>
