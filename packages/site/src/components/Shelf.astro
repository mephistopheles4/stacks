---
// The 3D island. Vanilla Three.js in a plain <script> — no React on the page.
// Markup and styles only: all logic lives in ../shelf/*.ts, which is
// typechecked. See "Site code layout" in CLAUDE.md.
---

<div class="shelf">
  <!--
    `tabindex="-1"` makes the canvas *programmatically* focusable without ever
    becoming a tab stop. It is where focus lands when the put-back control that
    held it goes away with the book, and only then.
  -->
  <canvas id="shelf-canvas" tabindex="-1"></canvas>

  <!--
    The announcer: permanently present and visually hidden. «Title» by «Author»
    when a book is picked up, the new book's on a second pickup, and empty after
    put-back (spec §3.4). The held book's pages are ordinary DOM in reading
    order, placed in the scene by ../shelf/pickup.ts; this is what tells a
    screen reader a book is in hand at all, since the canvas has no accessible
    children.
  -->
  <p id="pickup-status" class="visually-hidden" role="status"></p>

  <!--
    The cover, larger. A real `<dialog>` opened with `showModal`: focus moves
    in, the page goes inert, Escape closes it, and focus returns to the control
    on the held book's page that opened it. One Escape closes this and leaves
    the book held.

    In the template rather than built at runtime, so Astro's scoping reaches it
    and the styles below need no `:global()`.
  -->
  <dialog id="cover-viewer" class="cover-viewer" aria-label="Book cover"><!--
    Replaced with the book's own name when it opens; this is what it says if
    something goes wrong before that.
  -->
    <img id="cover-viewer-image" alt="" />
    <button id="cover-viewer-close" class="cover-viewer-close" type="button">
      <span class="visually-hidden">Close the cover</span>
    </button>
  </dialog>
</div>

<script>
  import { start } from '../shelf/start.ts';

  start();
</script>

<style>
  .shelf {
    position: absolute;
    inset: 0;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  /*
   * The held book's pages, placed by `CSS3DRenderer` in ../shelf/pickup.ts.
   * `:global` because that module creates them, and Astro only stamps its
   * scoping attribute on elements that were in this template. Sizes, opacity
   * and visibility are set through CSSOM there, which `style-src` does not
   * govern; everything here is the static look.
   */
  .shelf :global(.held-layer) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Above the canvas, below the two debug surfaces (10 and 11). */
    z-index: 5;
  }

  .shelf :global(.held-page) {
    box-sizing: border-box;
    padding: 44px 40px;
    overflow: hidden;
    color: #2b2520;
    font: 17px/1.55 Georgia, 'Iowan Old Style', 'Palatino Linotype', serif;
    overflow-wrap: anywhere;
  }

  .shelf :global(.held-page-left) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .shelf :global(.held-title) {
    margin: 0;
    font: 600 26px/1.2 Georgia, serif;
  }

  .shelf :global(.held-page-right .held-title) {
    font-size: 22px;
  }

  .shelf :global(.held-author) {
    margin: 14px 0 0;
    font-style: italic;
    color: #5d5347;
  }

  .shelf :global(.held-page-right .held-author) {
    margin-bottom: 22px;
  }

  .shelf :global(.held-label) {
    margin: 0 0 22px;
    font: 600 12px/1 ui-sans-serif, system-ui, sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a7d6c;
  }

  .shelf :global(.held-thoughts p:not(.held-label)) {
    margin: 0 0 14px;
    text-indent: 1.4em;
    white-space: pre-line;
  }

  .shelf :global(.held-thoughts hr) {
    margin: 20px 0;
    border: 0;
    border-top: 1px solid rgba(43, 37, 32, 0.2);
  }

  .shelf :global(.held-page .reading) {
    margin: 0 0 10px;
    font-style: italic;
  }

  .shelf :global(.held-page .tags),
  .shelf :global(.held-page .object),
  .shelf :global(.held-page .subjects) {
    margin: 0 0 8px;
    font: 14px/1.5 ui-sans-serif, system-ui, sans-serif;
    color: #5d5347;
  }

  .shelf :global(.held-page .card-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    margin-top: 10px;
    font: 14px/1.5 ui-sans-serif, system-ui, sans-serif;
  }

  .shelf :global(.held-page .card-link) {
    display: inline-flex;
    align-items: center;
    /* WCAG 2.5.5: the row is the page's main tappable content. */
    min-height: 2.75rem;
    color: #5d5347;
    text-decoration: none;
  }

  .shelf :global(.held-page .card-link:hover),
  .shelf :global(.held-page .card-link:focus-visible) {
    color: #2b2520;
  }

  .shelf :global(.held-page .card-mark) {
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }

  .shelf :global(.held-page .card-cover),
  .shelf :global(.held-put-back) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin: 12px 12px 0 0;
    padding: 0 14px;
    border: 1px solid rgba(43, 37, 32, 0.3);
    border-radius: 6px;
    background: transparent;
    color: #2b2520;
    font: 14px/1 ui-sans-serif, system-ui, sans-serif;
    cursor: pointer;
  }

  .shelf :global(.held-page .card-cover) {
    cursor: zoom-in;
  }

  .shelf :global(.held-page button:focus-visible),
  .shelf :global(.held-page a:focus-visible) {
    outline: 2px solid #2b2520;
    outline-offset: 2px;
  }

  /*
   * Shown when there is no shelf to show, with the canvas hidden behind it —
   * see showNotice in ../shelf/shelf-notice.ts. `:global` because that module
   * creates it, and Astro only stamps its scoping attribute on elements that
   * were in this template.
   */
  .shelf :global(.shelf-notice) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(24rem, calc(100vw - 3rem));
    margin: 0;
    transform: translate(-50%, -50%);
    text-align: center;
    text-wrap: balance;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #a89684;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /*
    The enlarged cover. The dialog is a frame around one image and nothing else,
    so it carries no chrome of its own — the UA's border, padding and background
    all go, and what is left is the picture on a scrim.

    `max-width`/`max-height` only, with no width: an `<img>` left to its natural
    size renders at exactly that and shrinks only when it would not fit. Which
    is the honest ceiling here — the staged file is capped at MAX_COVER_EDGE,
    and scaling it past native would make the "see it closer" answer blurrier
    than the thumbnail it came from.
  */
  /*
    Position, `inset: 0`, `margin: auto` and `width: fit-content` are the UA's
    own rules for `dialog:modal`, and they already centre a shrink-wrapped box.
    They are deliberately not restated: overriding `position` or `margin` here
    is what breaks that centring, because `inset: 0` with an author `width` no
    longer resolves to fit-content. Only the chrome is removed.
  */
  .cover-viewer {
    max-width: 100%;
    max-height: 100%;
    padding: 0;
    border: 0;
    background: none;
    /* The close control hangs off the corner; the UA's `auto` would clip it. */
    overflow: visible;
    cursor: zoom-out;
  }

  .cover-viewer::backdrop {
    background: rgba(10, 8, 7, 0.82);
    backdrop-filter: blur(6px);
  }

  .cover-viewer img {
    display: block;
    max-width: 92vw;
    max-height: 88vh;
    border-radius: 0.35rem;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.7);
  }

  /*
    Redundant with "click anywhere", and deliberately so: a surface you can only
    leave by knowing a convention is a surface some people are stuck on.

    **Top-right of the viewport, not of the image**, and that is what `fixed`
    rather than `absolute` buys. The dialog shrink-wraps its image, so anchoring
    to it put the control on the artwork's corner the moment the image filled the
    screen — which is every phone, where the cover is 339px of a 375px viewport.
    A fixed descendant of a top-layer dialog resolves against the viewport, and
    can here because nothing above it carries a transform or a filter; the
    `backdrop-filter` lives on `::backdrop`, which is a sibling pseudo-element
    and not an ancestor.

    The plate stays, quieter. It is over the scrim in the common case and does
    not need to work hard — but on a short landscape viewport a 92vw image can
    still reach the corner, and a light glyph alone on a pale cover would vanish.
  */
  .cover-viewer-close {
    position: fixed;
    top: clamp(0.75rem, 3vw, 1.5rem);
    right: clamp(0.75rem, 3vw, 1.5rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(26, 22, 19, 0.6);
    color: #f2e8dc;
    cursor: pointer;
  }

  .cover-viewer-close::before {
    content: '\00d7';
    font-size: 1.35rem;
    line-height: 1;
  }
</style>
