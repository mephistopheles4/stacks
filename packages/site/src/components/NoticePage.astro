---
import type { NoticeProps } from '../site-meta.ts';
import { absoluteUrl } from '../site-meta.ts';
import { analyticsOn } from '../analytics/on.ts';
import AnalyticsStart from './AnalyticsStart.astro';

// A page of notice text: the shelf's palette, no canvas, and `noindex`. Shared by `/attribution`
// and `/privacy`, so the two are one layout and cannot drift. The text and its type are the
// notice components', `AttributionNotice` and `PrivacyNotice`, which the modal over the shelf uses too.
//
// Deliberately **no canvas**: this is a page of legal text, and a WebGL scene
// behind it would be the most prominent element on a page whose entire purpose
// is a notice Google says must not be outshone.
const { title, description } = Astro.props as NoticeProps;
const ogImage = absoluteUrl('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a1613" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!--
      The same posture as the shelf, carried over deliberately rather than
      inherited: `noindex` is a per-page tag. `gate:public`'s robots rule reads
      every built page for exactly this reason.
    --><meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
  </head>
  <body class="notice">
    <main>
      <slot />
    </main>
    {analyticsOn && <AnalyticsStart />}
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  /*
    Not the shelf's `overflow: hidden; height: 100%` — this page is text, and
    text scrolls.
  */
  html,
  body.notice {
    margin: 0;
    background: #1a1613;
  }

  /*
    Layout only. The type the notice is read in (size, colour, headings, links) is
    `NoticeBody`'s, shared with the modal over the shelf (docs/spec/notice-modals.md N12): a rule
    here would out-rank it on this page alone and the two would drift.
  */
  body.notice main {
    max-width: 40rem;
    margin: 0 auto;
    padding: clamp(2rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem);
  }

  /* `main` in the selector lifts it over `NoticeBody`'s paragraph margin (0,2,1). */
  body.notice main .back {
    margin-top: 3rem;
  }
</style>
