---
import CreditList from '../components/CreditList.astro';
import NoticeBody from '../components/NoticeBody.astro';
import NoticePage from '../components/NoticePage.astro';
import { buildCredits } from '../notice/credits.ts';
import creditNotes from '../../rooms/reading-corner/credits.json';
import roomInputs from '../../rooms/reading-corner/inputs.json';

// The 3D credits (#621): every asset the room is baked from, with its creator, a link to where it
// came from, its licence and what the bake changed. The rows are `inputs.json` grouped by asset,
// so an input cannot ship without one: `buildCredits` stops the build on an input with no entry in
// `credits.json`, and G75 (`room-inputs`) holds the same. The layout and the `noindex` are
// `NoticePage`'s; every string is escaped text, and the only links are the https ones the rows carry.
const rows = buildCredits(roomInputs.inputs, creditNotes.credits);
const required = rows.filter((row) => row.required);
const courtesy = rows.filter((row) => !row.required);
---

<NoticePage title="3D credits — Stacks" description="The models, textures and pictures the reading corner is made from, and who made them.">
  <NoticeBody>
    <h1>3D credits</h1>

    <p>
      The reading corner is baked from the work below. Each asset is credited to its creator and
      linked to where it came from, and the note under it says how it was changed to fit the room.
    </p>

    <h2>Credit required</h2>
    <p>
      Used under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, which asks
      for this credit.
    </p>
    <CreditList rows={required} />

    <h2>CC0 and public domain</h2>
    <p>These need no credit and are listed as a courtesy.</p>
    <CreditList rows={courtesy} />

    <p class="back"><a href="/attribution">Back to attribution</a></p>
  </NoticeBody>
</NoticePage>
