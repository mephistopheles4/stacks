---
import Attribution from '../components/Attribution.astro';
import Shelf from '../components/Shelf.astro';
import { absoluteUrl } from '../site-meta.ts';

// The mark itself, inlined rather than fetched: it is four rects, and an <img>
// would be a second request for 442 bytes that arrives after the header has
// already been painted. `?raw` so there is one copy of the artwork — the file
// in src/assets/ — instead of a duplicate pasted into this template that would
// drift the first time the logo is touched.
import markSvg from '../assets/stacks-mark-inverse.svg?raw';

// Link-preview scrapers require absolute URLs; see site-meta.ts.
const ogImage = absoluteUrl('/og.png', Astro.site);
const pageUrl = absoluteUrl('/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      SVG first, because it is the source and scales to whatever size the
      browser asks for; the two PNGs are the fallback for browsers that ignore
      it, and the touch icon is a PNG because iOS accepts nothing else. The
      three PNGs are rasterised from the SVGs by `scripts/make-icons.ts` and
      committed alongside them.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!--
      The brand's paper is #FBF6EC and this is deliberately not that. The value
      colours the browser's own chrome, which sits directly above the page — and
      the page is a near-black room with a lit bookcase in it. Cream above that
      reads as a rendering fault rather than as branding. The palette's paper
      belongs on the icons and the share card, which are seen on somebody else's
      background, never against this one.
    -->
    <meta name="theme-color" content="#1a1613" />
    <title>Stacks</title>
    <meta name="description" content="A reading library, rendered as a shelf." />
    <!--
      Shareable, not searchable. A reading list is a fine thing to send someone
      and a strange thing to have turn up beside your name in a search result.

      This is the *authoritative* signal, and robots.txt is deliberately not
      used to do it: `Disallow` stops a crawler fetching the page, which means
      it never reads this tag, and a URL that is linked anywhere can still be
      indexed on the strength of the link alone. Blocking the crawl is the
      intuitive move and the one that fails. Let them read the page; tell them
      not to index it.
    -->
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="Stacks" />
    <meta property="og:description" content="A reading library, rendered as a shelf." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Shelf />
    <header>
      <!--
        aria-hidden because the mark carries its own role="img" and aria-label,
        and the <h1> beside it already says the name. Without this a screen
        reader announces "Stacks" twice in a row for one logo.
      -->
      <div class="brand">
        <span class="mark" aria-hidden="true" set:html={markSvg} />
        <h1>stacks</h1>
      </div>
      <p>Drag to look around · click a book</p>
    </header>
    <!--
      Persistent rather than card-conditional, and the repo decided that rather
      than taste: `pages` drives spine thickness, so the shelf renders
      Google-derived geometry continuously with no card open. A graphic that
      appeared only when the card opened would be absent for the whole time the
      obligation is live.
    -->
    <Attribution />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #f2e8dc;
    --ink-dim: #a89684;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #1a1613;
    color: var(--ink);
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
  }

  /*
    The whole lockup derives from two numbers, and every offset below is
    arithmetic on them rather than a value picked by eye.

    `--mark-size` is the artwork's *box*, and the box is mostly padding: the
    bars span 40 of its 64 units vertically and 50 of 64 horizontally. The brand
    sheet asks for the mark's height to match the wordmark's cap height, and
    IBM Plex Mono's caps are ~0.70em — so the ink must be 0.70em, and the box
    that holds 40/64 of ink at that height is 0.70 / (40/64) = 1.12em.

    `--bar` is one bar height, the sheet's unit of clear space. `--mark-inset`
    is the padding the artwork already carries on its left and right, which has
    to be *subtracted* from every gap: the SVG's own margin is clear space too,
    and adding a full bar beside it would set the wordmark 18 units away rather
    than 11.
  */
  header {
    --brand-size: clamp(1.5rem, 4vw, 2.25rem);
    --mark-size: calc(var(--brand-size) * 1.12);
    --bar: calc(var(--mark-size) * 11 / 64);
    --mark-inset: calc(var(--mark-size) * 7 / 64);

    position: absolute;
    top: clamp(1rem, 4vw, 2.5rem);
    left: clamp(1rem, 4vw, 2.5rem);
    pointer-events: none;
  }

  .brand {
    display: flex;
    align-items: center;
    font-size: var(--brand-size);
    /* One bar of clear space measured from the ink, not from the empty box. */
    gap: calc(var(--bar) - var(--mark-inset));
  }

  /*
    Pulled left by that same inset, so the ink lines up with the caption
    underneath instead of the invisible edge of the box. The clear space on the
    left and top is then the header's own offset from the viewport, which is
    `1rem` at its smallest against a bar of about `0.29rem`.
  */
  .mark {
    display: block;
    flex: none;
    width: var(--mark-size);
    height: var(--mark-size);
    margin-left: calc(var(--mark-inset) * -1);
  }

  /* Overrides the width/height attributes the artwork carries. */
  .mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  h1 {
    margin: 0;
    /*
      Lowercase mono, per the brand sheet: IBM Plex Mono 500. No webfont is
      loaded — one more request and ~30 KB for six letters, on a page whose
      first paint is a WebGL scene — so this asks for it and takes whatever
      monospace the machine has otherwise. The letterforms differ; the shape of
      the wordmark does not.
    */
    font-family:
      'IBM Plex Mono', ui-monospace, 'Cascadia Mono', 'Segoe UI Mono', 'Roboto Mono', monospace;
    font-size: 1em;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* One bar height below the wordmark — the fourth side of the clear space. */
  header p {
    margin: var(--bar) 0 0;
    font-size: 0.875rem;
    color: var(--ink-dim);
  }
</style>
