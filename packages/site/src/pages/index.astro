---
import Ask from '../ask/Ask.astro';
import Attribution from '../components/Attribution.astro';
import Shelf from '../components/Shelf.astro';
import Notices from '../notice/Notices.astro';
import { absoluteUrl } from '../site-meta.ts';

// The mark itself, inlined rather than fetched: it is four rects, and an <img>
// would be a second request for 442 bytes that arrives after the header has
// already been painted. `?raw` so there is one copy of the artwork — the file
// in src/assets/ — instead of a duplicate pasted into this template that would
// drift the first time the logo is touched.
import markSvg from '../assets/stacks-mark-inverse.svg?raw';

// Link-preview scrapers require absolute URLs; see site-meta.ts.
const ogImage = absoluteUrl('/og.png', Astro.site);
const pageUrl = absoluteUrl('/', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      SVG first, because it is the source and scales to whatever size the
      browser asks for; the two PNGs are the fallback for browsers that ignore
      it, and the touch icon is a PNG because iOS accepts nothing else. The
      three PNGs are rasterised from the SVGs by `scripts/make-icons.ts` and
      committed alongside them.
    --><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!--
      The brand's paper is #FBF6EC and this is deliberately not that. The value
      colours the browser's own chrome, which sits directly above the page — and
      the page is a near-black room with a lit bookcase in it. Cream above that
      reads as a rendering fault rather than as branding. The palette's paper
      belongs on the icons and the share card, which are seen on somebody else's
      background, never against this one.
    --><meta name="theme-color" content="#1a1613" />
    <title>Stacks</title>
    <meta name="description" content="A reading library, rendered as a shelf." />
    <!--
      Shareable, not searchable. A reading list is a fine thing to send someone
      and a strange thing to have turn up beside your name in a search result.

      This is the *authoritative* signal, and robots.txt is deliberately not
      used to do it: `Disallow` stops a crawler fetching the page, which means
      it never reads this tag, and a URL that is linked anywhere can still be
      indexed on the strength of the link alone. Blocking the crawl is the
      intuitive move and the one that fails. Let them read the page; tell them
      not to index it.
    --><meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="Stacks" />
    <meta property="og:description" content="A reading library, rendered as a shelf." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <!--
      The debug pane's two placeholders, empty on purpose. Tweakpane injects a
      runtime <style> per bundle unless one carrying its id is already here, and
      the CSP refuses an injected one, so pre-seating them is what keeps the pane
      styled behind ?debug (#376, ADR-0104). The CSS itself arrives as a file
      through a lazy <link>. Being empty, they need no hash in style-src: Astro
      wrote the empty string's hash until 7.4.3 and no longer does, and the
      styled-pane gate asserts the outcome (no CSP violation, a styled pane),
      not that hash. Both ids carry `plugin-`, the core's own included: it registers its
      stylesheet as a plugin does. `is:inline` keeps Astro from treating them
      as component styles.
    --><style is:inline data-tp-style="plugin-default"></style>
    <style is:inline data-tp-style="plugin-essentials"></style>
  </head>
  <body>
    <Shelf />
    <header>
      <!--
        aria-hidden because the mark carries its own role="img" and aria-label,
        and the <h1> beside it already says the name. Without this a screen
        reader announces "Stacks" twice in a row for one logo.
      -->
      <div class="brand">
        <span class="mark" aria-hidden="true" set:html={markSvg}></span>
        <h1>stacks</h1>
      </div>
      <p id="shelf-hint">Drag to look around · click a book</p>
      <!--
        The held book's controls (#531), at the top right since #553. They live
        here and not on the pages: a book arrives closed with its pages hidden,
        so a control on them could be neither seen nor focused. Both are real
        buttons. The X is hard-coded markup, so nothing is built from a string
        and no style attribute reaches the CSP; the Open button's words are set
        through textContent by shelf/pickup.ts. `hidden` until a book is in hand.
        The description says what the hint cannot while the book is open: that
        a closed book turns, and how.
      -->
      <div id="held-controls" class="held-controls" hidden>
        <p id="held-help" class="visually-hidden">
          Drag the closed book, or use the arrow keys, to turn it. Click it, or
          use Open, to open it.
        </p>
        <button
          id="held-put-back"
          class="held-put-back"
          type="button"
          aria-describedby="held-help"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg
          >
          <span class="visually-hidden">Put the book back</span>
        </button>
        <button id="held-open" class="held-open" type="button" hidden></button>
      </div>
    </header>
    <!--
      Persistent rather than card-conditional, and the repo decided that rather
      than taste: `pages` drives spine thickness, so the shelf renders
      Google-derived geometry continuously with no card open. A graphic that
      appeared only when the card opened would be absent for the whole time the
      obligation is live.
    -->
    <Attribution />
    <Ask />
    <Notices />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #f2e8dc;
    --ink-dim: #a89684;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #1a1613;
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /*
    The whole lockup derives from two numbers, and every offset below is
    arithmetic on them rather than a value picked by eye.

    `--mark-size` is the artwork's *box*, and the box is mostly padding: the
    bars span 40 of its 64 units vertically and 50 of 64 horizontally. The brand
    sheet asks for the mark's height to match the wordmark's cap height, and
    IBM Plex Mono's caps are ~0.70em — so the ink must be 0.70em, and the box
    that holds 40/64 of ink at that height is 0.70 / (40/64) = 1.12em.

    `--bar` is one bar height, the sheet's unit of clear space. `--mark-inset`
    is the padding the artwork already carries on its left and right, which has
    to be *subtracted* from every gap: the SVG's own margin is clear space too,
    and adding a full bar beside it would set the wordmark 18 units away rather
    than 11.
  */
  header {
    --brand-size: clamp(1.5rem, 4vw, 2.25rem);
    --mark-size: calc(var(--brand-size) * 1.12);
    --bar: calc(var(--mark-size) * 11 / 64);
    --mark-inset: calc(var(--mark-size) * 7 / 64);

    position: absolute;
    top: clamp(1rem, 4vw, 2.5rem);
    left: clamp(1rem, 4vw, 2.5rem);
    pointer-events: none;
  }

  .brand {
    display: flex;
    align-items: center;
    font-size: var(--brand-size);
    /* One bar of clear space measured from the ink, not from the empty box. */
    gap: calc(var(--bar) - var(--mark-inset));
  }

  /*
    Pulled left by that same inset, so the ink lines up with the caption
    underneath instead of the invisible edge of the box. The clear space on the
    left and top is then the header's own offset from the viewport, which is
    `1rem` at its smallest against a bar of about `0.29rem`.
  */
  .mark {
    display: block;
    flex: none;
    width: var(--mark-size);
    height: var(--mark-size);
    margin-left: calc(var(--mark-inset) * -1);
  }

  /* Overrides the width/height attributes the artwork carries. */
  .mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  h1 {
    margin: 0;
    /*
      Lowercase mono, per the brand sheet: IBM Plex Mono 500. No webfont is
      loaded — one more request and ~30 KB for six letters, on a page whose
      first paint is a WebGL scene — so this asks for it and takes whatever
      monospace the machine has otherwise. The letterforms differ; the shape of
      the wordmark does not.
    */
    font-family:
      'IBM Plex Mono', ui-monospace, 'Cascadia Mono', 'Segoe UI Mono', 'Roboto Mono', monospace;
    font-size: 1em;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* One bar height below the wordmark — the fourth side of the clear space. */
  /* `pre-line`: the closed book's hint is two short lines, clear of the book. */
  header p {
    margin: var(--bar) 0 0;
    white-space: pre-line;
    font-size: 0.875rem;
    color: var(--ink-dim);
  }

  /*
    The held book's X and Open button (#531), in the viewport's top-right corner
    since #553: under the logo they lay over the open book's left page. Fixed, out of the header's flow; the
    header lets pointer events through to the canvas, so these set them back.
    Layer 5, the same as the held pages and the Ask launcher: the controls come
    later in the document than the pages, so they paint over an open page, and
    earlier than the launcher and the panel (20), which paint over them. The X
    comes first in the document and the row runs right to left, so a long Open
    title wraps leftward under it and the X never moves.
  */
  .held-controls {
    --held-inset: clamp(0.75rem, 3vw, 1.5rem);

    position: fixed;
    top: var(--held-inset);
    right: var(--held-inset);
    z-index: 5;
    display: flex;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    max-width: calc(100vw - 2 * var(--held-inset));
    pointer-events: auto;
  }

  /*
    Beside the Ask panel, never under it, wherever the panel leaves room: it is
    fixed to the right edge above them, so the X would sit under the panel's own
    close and a click meant for the book would close the drawer. Narrower than
    40rem the space left of the panel is too thin: the X would sit on the
    brand, so the controls wait under the panel there. 27rem
    is the panel's own width, `min(27rem, 100%)` in ../ask/Ask.astro: change
    one and change the other.
  */
  @media (min-width: 40rem) {
    body:has(#ask-panel:not([hidden])) .held-controls {
      right: calc(27rem + var(--held-inset));
      max-width: calc(100vw - 27rem - 2 * var(--held-inset));
    }
  }

  .held-controls[hidden],
  .held-controls .held-open[hidden] {
    display: none;
  }

  .held-put-back {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(26, 22, 19, 0.6);
    color: var(--ink);
    cursor: pointer;
  }

  /* Visually hidden until it has focus: a mouse sees a closed book and nothing else. */
  .held-open:not(:focus) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .held-open:focus {
    min-width: 0;
    min-height: 2.75rem;
    max-width: 100%;
    padding: 0.5rem 0.9rem;
    border: 1px solid rgba(242, 232, 220, 0.4);
    border-radius: 1.4rem;
    background: rgba(26, 22, 19, 0.85);
    color: var(--ink);
    font: 0.875rem/1.3 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    text-align: left;
    cursor: pointer;
    overflow-wrap: anywhere;
  }

  .held-controls button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .held-controls .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
