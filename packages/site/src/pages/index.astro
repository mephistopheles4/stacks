---
import Shelf from '../components/Shelf.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Stacks</title>
    <meta name="description" content="A reading library, rendered as a shelf." />
  </head>
  <body>
    <Shelf />
    <header>
      <h1>Stacks</h1>
      <p>Empty shelf — books arrive in phase 2.</p>
    </header>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --ink: #f2e8dc;
    --ink-dim: #a89684;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #1a1613;
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  header {
    position: absolute;
    top: clamp(1rem, 4vw, 2.5rem);
    left: clamp(1rem, 4vw, 2.5rem);
    pointer-events: none;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  header p {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-dim);
  }
</style>
