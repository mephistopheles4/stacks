---
import AttributionNotice from '../components/AttributionNotice.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';

// The attribution and privacy notices as one modal over the shelf
// (docs/spec/notice-modals.md N1, N3): both texts rendered into this page, one panel shown at a
// time, opened by a plain click on a link to `/attribution` or `/privacy`. The text is the same
// components the two direct pages use, so there is one copy of each notice. Markup and styles
// only; `modal.ts` holds the behaviour. The ids are the seam (`open.ts`).
---

<dialog id="notice-dialog" class="notice-dialog" aria-labelledby="notice-attribution-title">
  <div class="notice-sheet">
    <button id="notice-close" class="notice-close" type="button">Close</button>
    <section id="notice-attribution">
      <AttributionNotice headingId="notice-attribution-title" />
    </section>
    <section id="notice-privacy" hidden>
      <PrivacyNotice headingId="notice-privacy-title" />
    </section>
  </div>
</dialog>

<script>
  import { startNotices } from './start.ts';

  startNotices();
</script>

<style>
  /*
    The dialog is the scroll container and has no padding of its own: the sheet inside carries
    it, so a click on the dialog element itself is a click on the backdrop and nowhere else
    (N9). Capped at the viewport and scrolling inside itself (N13), because the shelf page is
    overflow: hidden. No blur, no animation, nothing on the backdrop that costs a frame (N10).
  */
  .notice-dialog {
    box-sizing: border-box;
    width: min(42rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 1px solid rgba(242, 232, 220, 0.2);
    border-radius: 0.75rem;
    background: #1a1613;
    color: #c9b8a4;
  }

  .notice-dialog::backdrop {
    background: rgba(10, 8, 7, 0.72);
  }

  .notice-sheet {
    padding: clamp(1.25rem, 5vw, 2.5rem);
  }

  .notice-close {
    display: block;
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin: 0 0 0.5rem auto;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(242, 232, 220, 0.4);
    border-radius: 1.4rem;
    background: transparent;
    color: #f2e8dc;
    font: 1rem/1.3 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    cursor: pointer;
  }

  .notice-close:hover {
    background: rgba(242, 232, 220, 0.12);
  }

  .notice-dialog :global(:focus-visible) {
    outline: 2px solid #f2e8dc;
    outline-offset: 2px;
  }

  .notice-dialog :global([tabindex='-1']:focus) {
    outline: none;
  }

  .notice-sheet section[hidden] {
    display: none;
  }
</style>
