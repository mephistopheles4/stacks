node_modules/
dist/
.astro/
.cache/

# Build artifacts — always regenerable from the vault, never hand-edited (AGENTS.md invariant 1).
# `stacks build --public` stages all four of these into packages/site/public/.
# Everything else in that folder is committed brand art — favicon.svg, the two
# favicon PNGs, the touch icon, and og.png — and a build must never write over
# it. `notes/` holds the owner's published Thoughts: a broad `git add` after a
# real build would put them into public history, beyond retraction.
# `held-covers/` holds a 1200px copy of every published cover, some of them
# photographed by the owner, for the same reason.
library.json
packages/site/public/covers/
packages/site/public/notes/
packages/site/public/held-covers/
# Written by the build from Tweakpane's JavaScript; see scripts/lib/tuner-css-plugin.ts.
packages/site/src/generated/

# Screenshots are regenerable via `pnpm smoke:render`; keep binaries out of the repo
artifacts/

.env
.env.*
!.env.example

*.log
.DS_Store
Thumbs.db

# Generated by scripts/make-50-book-fixture.ts — vault-50, and vault-N for `--books N`.
# Does not match the committed fixtures/vault/.
fixtures/vault-*/

# Subagent worktrees — real git checkouts, never part of this repo.
.claude/worktrees/

# IDE workspace config
.idea/
.vscode/

# Stryker sandbox (mutation runs); the reports go to the ignored artifacts/ tree
.stryker-tmp/

# One CI run's metrics record, written by scripts/emit-metrics.ts. It belongs on
# the orphan `metrics` branch and never on main — scripts/commit-metrics.ts puts
# it there.
metrics/

# One coverage run, written only when `--coverage` is passed — which nothing in
# CI passes. It exists for the opt-in pre-commit CRAP print, which reads it and
# throws it away; no number in it is ever a floor, a series or a badge.
.coverage/

# The local trend store: a Prometheus data directory, the sync's state, and
# surface D's rows. Rebuildable from the `metrics` branch — except D's rows,
# which only this machine has, which is why `pnpm trend:sync --rebuild` replays
# them from .trend/local/ rather than re-probing history it cannot re-ask for.
.trend/
