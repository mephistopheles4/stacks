{
  "name": "stacks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --config eslint.lint.config.mjs .",
    "build": "pnpm run typecheck && pnpm --filter @stacks/site run build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @stacks/site run dev",
    "dev:watch": "tsx scripts/dev-watch.ts",
    "lint:md": "tsx scripts/lint-md.ts",
    "lint:md:fix": "tsx scripts/lint-md.ts --fix",
    "stacks": "tsx packages/cli/src/index.ts",
    "worktree": "tsx scripts/worktree.ts",
    "fixtures:50": "tsx scripts/make-50-book-fixture.ts",
    "smoke:render": "tsx scripts/smoke-render.ts",
    "gate:public": "tsx scripts/check-public-build.ts",
    "mutation:run": "stryker run",
    "mutation:score": "tsx scripts/mutation-scopes.ts",
    "mutation:stamp": "tsx scripts/stamp-floors.ts",
    "duplication:report": "tsx scripts/duplication-report.ts",
    "metrics:emit": "tsx scripts/emit-metrics.ts",
    "metrics:commit": "tsx scripts/commit-metrics.ts",
    "trend:sync": "tsx scripts/trend-sync.ts",
    "deploy:site": "tsx scripts/deploy.ts"
  },
  "athanor": {
    "dockerfile": "docker/athanor/Dockerfile",
    "context": "docker/athanor",
    "inputs": [
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "packages/cli/package.json",
      "packages/core/package.json",
      "packages/site/package.json"
    ],
    "commands": {
      "test": [
        "pnpm",
        "test"
      ],
      "typecheck": [
        "pnpm",
        "typecheck"
      ],
      "lint": [
        "pnpm",
        "lint"
      ],
      "build": [
        "pnpm",
        "build"
      ],
      "smoke": [
        "env",
        "CI=true",
        "pnpm",
        "smoke:render"
      ]
    },
    "memory": "6g",
    "cpus": 4,
    "timeoutMinutes": 30
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "github-slugger": "2.0.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "wrangler": "4.149.0"
  }
}
