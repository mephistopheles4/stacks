# Where your Obsidian vault lives. Every stacks command falls back to this when
# --vault is not passed, and `pnpm dev:watch` needs it.
#
# Copy this file to `.env` (which is gitignored) and set your own path.
STACKS_VAULT=C:\path\to\your\vault

# Optional, but close to essential if you read recent books.
#
# Open Library is the primary source and is thin on anything published in the
# last year or two. Google Books is the fallback and covers recent titles well —
# but unauthenticated requests share one global quota that is permanently
# exhausted, so without a key it 429s every single time and never answers.
#
# A key is free: console.cloud.google.com -> create a project -> enable the
# "Books API" -> Credentials -> Create credentials -> API key.
# GOOGLE_BOOKS_API_KEY=

# Port for `pnpm dev:watch`, which runs the site and rebuilds it whenever the
# vault changes. Only worth setting if something else already has 4322.
# PORT=4322
