{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // Covers every .ts in the repo, including the site's. It does NOT cover
  // .astro files — `astro check` does, run by packages/site's build script
  // inside `pnpm build`; see G50 (astro-types) in docs/gates.md. Logic still
  // belongs in .ts, for a different reason now: every mutation scope and every
  // complexity population globs *.ts, so logic in an .astro file is counted by
  // nothing. See "Site code layout" in AGENTS.md.
  // packages/site/tsconfig.json mirrors the strictness here so the editor and
  // this gate agree about the same file.
  "include": [
    "packages/core/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/site/src/**/*.ts",
    "scripts/**/*.ts",
    "gates/**/*.ts",
    "vitest.config.ts",
    "vitest.stryker.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.astro"]
}
