{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // Covers every .ts in the repo, including the site's. It does NOT cover
  // .astro files — nothing does, because `astro check` cannot run under
  // TypeScript 7 yet. That is why logic must stay out of .astro files; see
  // "Site code layout" in AGENTS.md. packages/site/tsconfig.json mirrors the
  // strictness here so the editor and this gate agree about the same file.
  "include": [
    "packages/core/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/site/src/**/*.ts",
    "scripts/**/*.ts",
    "gates/**/*.ts",
    "vitest.config.ts",
    "vitest.stryker.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.astro"]
}
